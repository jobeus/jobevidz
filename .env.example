# Copy to .env at the checkout root (git-ignored; chmod 600 on grizzly, where start.sh loads it).
# Real environment variables override these.

# grizzly: PORT=3020
PORT=3000
#HOST=127.0.0.1
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=1073741824
UPLOAD_DIR=../uploads
DATA_DIR=../data

# Logging
LOG_LEVEL=info

# yt-dlp Proxy (optional)
# Format: http://username:password@host:port
# Example: YTDLP_PROXY=http://USERNAME:PASSWORD@proxy.example.com:PORT
# YTDLP_PROXY=

# Sticky-session ports (DataImpulse: each port 10000+ is its own fixed exit IP). Each download
# attempt picks a random port from the range in place of YTDLP_PROXY's port, so one download
# keeps one IP and a retry gets another. Unset = use YTDLP_PROXY as is.
# YTDLP_PROXY_STICKY_PORTS=10000-10099

# Videos converted at once in the background (ffmpeg is CPU-heavy)
# PROCESSING_CONCURRENCY=2

# Deploy webhook: off unless the secret is set. Same value as the DEPLOY_WEBHOOK_SECRET
# Actions secret in jobeus/jobevidz. Make one with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
#DEPLOY_WEBHOOK_HOST=127.0.0.1
#DEPLOY_WEBHOOK_PORT=8790
#DEPLOY_BUILD_COMMAND=scripts/release-build.sh
